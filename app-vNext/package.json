{
  "name": "easy-system-app-vnext",
  "private": true,
  "version": "4.37.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
